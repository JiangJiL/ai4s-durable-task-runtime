<mxfile host="app.diagrams.net" modified="2026-09-22T00:00:00.000Z" agent="AI4S" version="26.0.16">
  <diagram id="ai4s-runtime-overview" name="总体架构">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AI4S Durable Task Runtime：OpenClaw 决策，Runtime 记录、对账与安全恢复" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1460" height="40" as="geometry"/></mxCell>

        <mxCell id="lane-openclaw" value="OpenClaw：认知与执行层（负责做什么、怎么做）" style="swimlane;html=1;rounded=1;startSize=34;fontSize=16;fontStyle=1;fillColor=#EAF2FF;swimlaneFillColor=#D6E8FF;strokeColor=#4A78A8;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1480" height="185" as="geometry"/></mxCell>
        <mxCell id="agent" value="项目 Agent&#xa;规划 / 推理 / 代码修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78A8;fontSize=15;fontStyle=1;" vertex="1" parent="lane-openclaw"><mxGeometry x="60" y="70" width="225" height="75" as="geometry"/></mxCell>
        <mxCell id="context" value="上下文工程&#xa;项目文件 · Git · 设计文档&#xa;会话 · 可选 RAG / Memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78A8;fontSize=14;" vertex="1" parent="lane-openclaw"><mxGeometry x="380" y="58" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="intent" value="受限 Intent&#xa;COMPLETE / FAIL /&#xa;SUBMIT_JOB / PAUSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#C68A2B;fontSize=14;" vertex="1" parent="lane-openclaw"><mxGeometry x="1060" y="63" width="250" height="90" as="geometry"/></mxCell>

        <mxCell id="lane-runtime" value="Durable Task Runtime：事实与生命周期层（负责已经做了什么、现在在哪里、能否安全继续）" style="swimlane;html=1;rounded=1;startSize=34;fontSize=16;fontStyle=1;fillColor=#ECF8F0;swimlaneFillColor=#D9F0E1;strokeColor=#4E8A63;fontColor=#1D5B36;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1480" height="300" as="geometry"/></mxCell>
        <mxCell id="api" value="Runtime API&#xa;claim / context / intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E8A63;fontSize=14;fontStyle=1;" vertex="1" parent="lane-runtime"><mxGeometry x="55" y="75" width="195" height="70" as="geometry"/></mxCell>
        <mxCell id="state" value="状态机与规则校验&#xa;Task · Step · Attempt&#xa;Allowed Actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E8A63;fontSize=14;" vertex="1" parent="lane-runtime"><mxGeometry x="325" y="60" width="235" height="100" as="geometry"/></mxCell>
        <mxCell id="mysql" value="MySQL（唯一事实来源）&#xa;Task · Step · Event&#xa;External Job · Checkpoint" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFF2CC;strokeColor=#B8891B;fontSize=14;fontStyle=1;" vertex="1" parent="lane-runtime"><mxGeometry x="650" y="52" width="245" height="115" as="geometry"/></mxCell>
        <mxCell id="outbox" value="Outbox Worker&#xa;幂等提交&#xa;at-least-once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E8A63;fontSize=14;" vertex="1" parent="lane-runtime"><mxGeometry x="985" y="55" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="reconciler" value="Reconciler / Retry&#xa;查询真实状态&#xa;Persist → Reconcile → Resume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E8A63;fontSize=14;" vertex="1" parent="lane-runtime"><mxGeometry x="1235" y="55" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="active" value="确定性 Active State&#xa;currentStep · attempt · job · error&#xa;checkpoint · allowedActions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#4E8A63;fontSize=13;" vertex="1" parent="lane-runtime"><mxGeometry x="415" y="195" width="375" height="62" as="geometry"/></mxCell>
        <mxCell id="crash" value="中断恢复原则：先 Reconcile 外部现实，再决定 Resume / Retry；不靠 RAG 猜任务进度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B85450;fontSize=14;fontStyle=1;fontColor=#7A1E1B;" vertex="1" parent="lane-runtime"><mxGeometry x="865" y="195" width="500" height="62" as="geometry"/></mxCell>

        <mxCell id="lane-exec" value="Tool / MCP / Shell Job：外部执行层（负责实际副作用与真实运行状态）" style="swimlane;html=1;rounded=1;startSize=34;fontSize=16;fontStyle=1;fillColor=#F7F3FF;swimlaneFillColor=#E9E0FF;strokeColor=#8064A2;fontColor=#4B2E72;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="1480" height="175" as="geometry"/></mxCell>
        <mxCell id="tools" value="短工具 / MCP&#xa;文件读取 · Git · API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8064A2;fontSize=14;" vertex="1" parent="lane-exec"><mxGeometry x="180" y="65" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="job" value="Async Job Adapter&#xa;Shell · Maven · Build · MCP Job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8064A2;fontSize=14;fontStyle=1;" vertex="1" parent="lane-exec"><mxGeometry x="655" y="60" width="275" height="85" as="geometry"/></mxCell>
        <mxCell id="artifacts" value="Artifact / 日志 / 应用 Checkpoint&#xa;大对象不进入 MySQL，只保存 URI 与元数据" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFF2CC;strokeColor=#B8891B;fontSize=14;" vertex="1" parent="lane-exec"><mxGeometry x="1105" y="55" width="290" height="95" as="geometry"/></mxCell>

        <mxCell id="legend" value="恢复路径：OpenClaw 重启 → claim READY Step → Runtime 返回确定性事实 → OpenClaw 重建项目上下文 → 执行并提交 Intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="1480" height="55" as="geometry"/></mxCell>

